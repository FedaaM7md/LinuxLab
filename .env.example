# Linux Lab — example environment overrides.
# Copy to `.env` only for local experiments; never commit `.env`.
# All VITE_* values are embedded in the client bundle. They are not secrets.

# Demo mode: true (default) shows the persistent demo banner and scheduled
# reset support. Set false to remove demo entry points from the build.
DEMO_MODE=true

# Application flag used by tooling (the app is fully client-side).
APP_DEBUG=false

# Optional: override where the v86 images are looked up (default: /images/).
# Must be a same-origin path; absolute URLs and //host paths are rejected.
VITE_IMAGE_BASE_PATH=/images/

# Optional: override image filenames inside the image folder.
VITE_V86_BIOS_FILE=seabios.bin
VITE_V86_VGA_BIOS_FILE=vgabios.bin
VITE_V86_CDROM_FILE=linux.iso
# Optional hard-disk image. Leave empty when booting from the ISO.
VITE_V86_HDD_FILE=

# Default guest RAM in MB (power of two, between 64 and 512).
VITE_V86_MEMORY_MB=128
